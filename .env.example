# Скопируйте в .env.local и заполните
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Supabase → Connect → Session pooler (порт 5432), с паролем базы
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Telegram: @BotFather → бот → Login Widget (OpenID Connect).
# Allowed URL: <сайт>/api/auth/callback/telegram. Токен бота — для уведомлений.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI: <сайт>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: developer.apple.com → Services ID (это CLIENT_ID) + ключ Sign in with Apple (.p8).
# Return URL: <сайт>/api/auth/callback/apple — только https, localhost не принимается.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# содержимое .p8 одной строкой, переводы строк как \n
APPLE_PRIVATE_KEY=

# Адрес сайта для ссылок в превью (og:image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
